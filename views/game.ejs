<!doctype html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#151a19" />
    <title><%= performanceMode ? 'Poligon — test wydajności' : 'Żar — obroń polanę' %></title>
    <link rel="stylesheet" href="/css/style.css" />
    <script type="module" src="/build/game.js"></script>
</head>
<body class="game-page">
<main id="content" class="game-shell">
    <% if (performanceMode) { %>
    <header class="game-header" data-game-ui>
        <a class="wordmark" href="/game"><span class="rune" aria-hidden="true">◇</span> POLIGON</a>
        <span class="expedition-round">Osobny świat testowy</span>
        <nav class="mode-switch" aria-label="Tryb gry"><a href="/game">Wyprawa</a><span aria-current="page">Test wydajności</span></nav>
        <form action="/logout" method="post"><button class="text-button" type="submit">Wyloguj ↗</button></form>
    </header>
    <section id="performance-panel" class="performance-panel" aria-label="Test wydajności">
        <div class="objective-copy" data-game-ui><h1>Test obciążenia</h1><p>Swobodny ruch i strzelanie. Bez celów i obrażeń gracza. Ustawienia wspólne dla poligonu.</p></div>
        <form data-performance-form class="performance-controls" data-game-ui>
            <label><span>Przeciwnicy <span class="performance-field-hint">0–<%= performanceMaxEnemies.toLocaleString('pl-PL') %></span></span><input name="count" type="number" min="0" max="<%= performanceMaxEnemies %>" step="1" value="500" inputmode="numeric" required /></label>
            <label>Rozmieszczenie<select name="distribution"><option value="nearby">Wokół mnie</option><option value="world">Cała mapa</option></select></label>
            <label>Zachowanie<select name="scenario"><option value="moving">Ruch</option><option value="static">Bezruch</option><option value="combat">Walka i pociski</option></select></label>
            <button class="button button-primary" type="submit">Załaduj</button><button class="button button-secondary" type="button" data-performance-clear>Wyczyść</button>
        </form>
        <p class="performance-status" role="status"><span data-performance="status">Łączymy z poligonem…</span><span class="performance-protocol" data-performance="protocol"></span></p>
        <div class="world-frame">
            <canvas id="game-canvas" aria-label="Poligon do testów wydajności"></canvas>
            <div class="world-caption" aria-hidden="true"><span class="status-dot"></span> POLIGON · GOD MODE</div>
            <div id="debug-window" hidden></div>
            <div id="chat-zone" data-game-ui><div id="chat-msgs" role="log" aria-label="Czat poligonu"></div><form id="chat-form"><label class="sr-only" for="chat-input">Wiadomość</label><input id="chat-input" type="text" maxlength="300" autocomplete="off" placeholder="Enter — czat poligonu" /></form></div>
        </div>
        <dl class="performance-metrics" data-game-ui>
            <div><dt>FPS klienta</dt><dd data-performance="fps">—</dd></div>
            <div><dt>Korekta pozycji · ostatnia / max 1 s</dt><dd data-performance="correction">—</dd></div>
            <div><dt>Na ekranie / znane klientowi</dt><dd><span data-performance="rendered">—</span> / <span data-performance="known">—</span></dd></div>
            <div><dt>Przeciwnicy na serwerze</dt><dd data-performance="enemies">0 / 0</dd></div>
            <div><dt>Wszystkie obiekty / aktywne chunki</dt><dd><span data-performance="objects">—</span> / <span data-performance="chunks">—</span></dd></div>
            <div><dt>Tick serwera · p50 / p95</dt><dd data-performance="tick">—</dd></div>
            <div><dt>Rzeczywiste tempo symulacji / snapshotów</dt><dd><span data-performance="simulation-hz">—</span> / <span data-performance="snapshot-hz">—</span></dd></div>
            <div><dt>Snapshot · p95 CPU</dt><dd data-performance="snapshot-cpu">—</dd></div>
            <div><dt>Budżet ticka / porzucony czas</dt><dd><span data-performance="budget">—</span> / <span data-performance="dropped">—</span></dd></div>
            <div><dt>Dane świata do tego klienta</dt><dd data-performance="traffic">—</dd></div>
        </dl>
        <p class="performance-note">Odległe chunki też wykonują symulację; klient dostaje swoją okolicę. Hz mierzy rzeczywiste tempo pracy; pierwsza próbka po sekundzie. Tick mierzy symulację, snapshot — zbieranie stanu, kodowanie i przekazanie do transportu, bez opóźnienia sieci. Transfer obejmuje binarne snapshoty bez narzutu transportu. Porzucony czas sumuje się od uruchomienia świata.</p>
    </section>
    <footer class="game-footer" data-game-ui><span><kbd>WASD</kbd> ruch <span class="control-separator">/</span> <kbd>LPM</kbd> strzał <span class="control-separator">/</span> <kbd>Enter</kbd> czat</span><span>Załaduj zastępuje poprzednią populację. Wyczyść usuwa przeciwników i pociski.</span></footer>
    <% } else { %>
    <div id="expedition-hud">
        <header class="game-header" data-game-ui>
            <a class="wordmark" href="/" aria-label="Żar — strona główna"><span class="rune" aria-hidden="true">✧</span> ŻAR</a>
            <span class="expedition-round" data-expedition="round">Przygotowujemy polanę…</span>
            <% if (performanceTests) { %><a class="mode-link" href="/game?mode=performance">Poligon / test wydajności ↗</a><% } %>
            <div class="expedition-stats"><span class="time-label">FALE</span><strong data-expedition="progress">0 / 6</strong><span class="stat-divider"></span><span class="time-label">CZAS</span><strong class="expedition-timer" data-expedition="timer">8:00</strong></div>
            <form action="/logout" method="post"><button class="text-button" type="submit">Opuść polanę ↗</button></form>
        </header>
        <div class="objective-bar" data-game-ui>
            <div class="objective-copy"><p class="eyebrow">PRZETRWAJCIE SZEŚĆ FAL</p><h1 data-expedition="objective">Obrońcie polanę</h1><p data-expedition="guidance">Łączymy z obozem…</p></div>
            <div class="expedition-compass wave-status" aria-label="Stan bieżącej fali"><span data-expedition="bearing">15 s</span><span data-expedition="distance">do pierwszej fali</span></div>
        </div>
        <div class="world-frame">
            <canvas id="game-canvas" aria-label="Polana — świat gry Żar"></canvas>
            <div class="world-caption" aria-hidden="true"><span class="status-dot"></span> POLANA · WSPÓLNA OBRONA</div>
            <div id="debug-window" hidden></div>
            <div id="chat-zone" data-game-ui>
                <div id="chat-msgs" role="log" aria-label="Czat drużyny"></div>
                <form id="chat-form"><label class="sr-only" for="chat-input">Wiadomość do drużyny</label><input id="chat-input" type="text" maxlength="300" autocomplete="off" placeholder="Enter — porozmawiaj z drużyną" /></form>
            </div>
            <div class="respawn-notice" data-expedition="respawn" hidden data-game-ui><span class="eyebrow">ZŁAP ODDECH</span><strong>Wracasz do ogniska za <span data-expedition="respawn-time">3</span>…</strong><span>Zachowujesz poziom i ulepszenia. Drużyna wciąż walczy.</span></div>
            <section class="result-panel" data-expedition="result" role="status" hidden data-game-ui><span class="eyebrow" data-expedition="result-label">KONIEC OBRONY</span><h2 data-expedition="result-title"></h2><p data-expedition="result-copy"></p><button class="button button-primary" data-expedition="restart" type="button">Jeszcze jedna obrona</button><form action="/logout" method="post" data-expedition="leave" hidden><button class="button button-primary" type="submit">Wróć do wejścia ↗</button></form></section>
        <section id="adventure-hud" class="adventure-hud" aria-label="Bohater, uzbrojenie i rozwój" data-game-ui>
            <div class="hero-progress">
                <span class="hero-level" aria-label="Poziom bohatera"><small>POZIOM</small><strong data-adventure="level">1</strong></span>
                <div class="hero-experience"><div><span class="eyebrow">DOŚWIADCZENIE</span><span data-adventure="xp">0 / 20 PD</span></div><progress data-adventure="xp-bar" value="0" max="20" aria-label="Doświadczenie do następnego poziomu"></progress><p><span class="loot-coin" aria-hidden="true">◈</span><strong data-adventure="coins">0</strong> monet <span class="hero-wave" data-adventure="wave">Fala 1</span></p></div>
            </div>
            <div class="hero-weapons" role="group" aria-label="Wybór broni">
                <button class="weapon-choice" type="button" data-adventure-weapon="ember" aria-pressed="true" aria-label="Żar · wybrana broń" disabled><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M17 3C19 12 25 12 25 20a9 9 0 1 1-18 0c0-6 5-8 5-13 3 3 2 6 3 8 4-3 0-7 2-12Z"/><path d="M17 17c0 4 4 5 3 8a4 4 0 0 1-8-1c0-3 3-4 5-7Z"/></svg><span><strong>Żar</strong><small data-weapon-detail>W EKWIPUNKU</small></span></button>
                <button class="weapon-choice" type="button" data-adventure-weapon="scatter" aria-pressed="false" aria-label="Rozprysk · od poziomu 2" disabled><svg viewBox="0 0 32 32" aria-hidden="true"><path d="m5 27 10-10m-5-7 3-7 5 4-3 7Zm8 8 7-3 4 5-7 3ZM19 9l6-6 4 4-6 6Z"/></svg><span><strong>Rozprysk</strong><small data-weapon-detail>POZIOM 2</small></span></button>
                <button class="weapon-choice" type="button" data-adventure-weapon="lance" aria-pressed="false" aria-label="Przebicie · od poziomu 3" disabled><svg viewBox="0 0 32 32" aria-hidden="true"><path d="m3 29 19-19m-4-3L29 3l-4 11-7-7ZM9 17l6 6m-10-2 6 6"/></svg><span><strong>Przebicie</strong><small data-weapon-detail>POZIOM 3</small></span></button>
            </div>
            <div class="hero-upgrades">
                <div class="hero-upgrade-heading"><span class="eyebrow" data-adventure="points">ROZWÓJ BOHATERA</span><span data-adventure="wave-time">Kolejna fala w drodze</span></div>
                <div class="upgrade-choices" role="group" aria-label="Ulepszenia za punkty rozwoju">
                    <button type="button" data-adventure-upgrade="power" disabled><span class="upgrade-symbol" aria-hidden="true">✧</span><span><strong>Moc</strong><small>+18% obrażeń</small></span><b data-upgrade-rank>0 / 5</b></button>
                    <button type="button" data-adventure-upgrade="haste" disabled><span class="upgrade-symbol" aria-hidden="true">↯</span><span><strong>Tempo</strong><small>−8% czasu między strzałami</small></span><b data-upgrade-rank>0 / 5</b></button>
                    <button type="button" data-adventure-upgrade="vitality" disabled><span class="upgrade-symbol" aria-hidden="true">♡</span><span><strong>Witalność</strong><small>+30 maks. zdrowia</small></span><b data-upgrade-rank>0 / 5</b></button>
                    <button type="button" data-adventure-upgrade="stride" disabled><span class="upgrade-symbol" aria-hidden="true">»</span><span><strong>Zwinność</strong><small>+5% szybkości ruchu</small></span><b data-upgrade-rank>0 / 5</b></button>
                </div>
            </div>
            <section class="hero-shop" data-adventure="shop" aria-label="Sklep na czas przerwy" hidden>
                <div class="hero-shop-heading"><span class="eyebrow">CHWILA NA ZAKUPY</span><span>Tylko w przerwie</span></div>
                <div class="shop-choices">
                    <button type="button" data-adventure-purchase="heal" disabled><span aria-hidden="true">✚</span><strong>Opatrunek<small>+60 zdrowia</small></strong><b>6 ◈</b></button>
                    <button type="button" data-adventure-purchase="training" disabled><span aria-hidden="true">✧</span><strong>Trening<small>+20 PD</small></strong><b>10 ◈</b></button>
                </div>
            </section>
            <p class="hero-notice" data-adventure="notice" role="status" aria-live="polite">Łączymy z bohaterem…</p>
        </section>
        </div>
        <div class="expedition-bottom" data-game-ui>
            <section class="party-section"><h2 class="eyebrow">TWOJA DRUŻYNA <span>1–4 GRACZY</span></h2><ul class="party-list" data-expedition="party"><li class="party-placeholder">Czekamy na obrońców…</li></ul></section>
            <section class="village-rules"><h2 class="eyebrow">RYTM OBRONY <span>POKONANI: <b data-expedition="kills">0</b></span></h2><p>Pokonaj falę → zbierz łup → kup wzmocnienia.</p><span>20 sekund przerwy po każdej fali. Żadna kolejna nie zacznie się, dopóki nie padnie ostatni przeciwnik.</span></section>
        </div>
        <footer class="game-footer" data-game-ui><span><kbd>WASD</kbd> ruch <span class="control-separator">/</span> <kbd>LPM</kbd> strzał <span class="control-separator">/</span> <kbd>PPM</kbd> fala mocy · 3 s odnowienia <span class="control-separator">/</span> <kbd>Q</kbd> broń <span class="control-separator">/</span> <kbd>Enter</kbd> czat</span><span>Podejdź po łup. W przerwie wydaj monety.</span><button class="text-button" data-expedition="debug" type="button" aria-pressed="false">Statystyki</button></footer>
    </div>
    <% } %>
</main>
</body>
</html>
