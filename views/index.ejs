<!doctype html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#151a19" />
    <title>Żar — obroń polanę</title>
    <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="landing-page">
    <div class="landing-shell">
        <header class="site-header">
            <a class="wordmark" href="/" aria-label="Żar — strona główna"><span class="rune" aria-hidden="true">✧</span> ŻAR</a>
            <span class="build-label">MAŁA GRA. WSPÓLNA OBRONA.</span>
        </header>
        <main class="landing-main">
            <div class="landing-copy">
                <p class="eyebrow"><span class="status-dot"></span> KOOPERACJA · 1–4 GRACZY</p>
                <h1>Mała polana.<br />Wielki kłopot.</h1>
                <p class="landing-lead">Sześć fal. Trzy bronie.<br />I chwila oddechu między walkami.</p>
                <p class="landing-description">Upiory nadciągają do wioski. Odpieraj je, lawiruj między chatami i zbieraj łup. Awansuj, składaj własny zestaw ulepszeń, a w przerwie zamień monety na zdrowie lub trening. Sam albo z drużyną — obrońcie polanę przed szóstą falą.</p>
                <% if (locals.error_message) { %>
                    <p class="login-error" role="alert"><%= error_message %></p>
                <% } %>
                <form id="guest-form" action="/login" method="post">
                    <input type="hidden" name="username" value="guest" />
                    <input type="hidden" name="password" value="guest" />
                    <button class="button button-primary" type="submit">Wejdź na polanę <span aria-hidden="true">↗</span></button>
                    <span class="cta-note">Bez konta i bez instalacji. Po prostu wejdź.</span>
                </form>
                <% if (performanceTests) { %>
                <form class="performance-entry" action="/login?mode=performance" method="post">
                    <input type="hidden" name="username" value="guest" /><input type="hidden" name="password" value="guest" />
                    <button class="button button-secondary" type="submit">Poligon / test wydajności ↗</button>
                    <span class="cta-note">Osobny świat. Własna liczba przeciwników, ruch i pociski.</span>
                </form>
                <% } %>
                <details class="account-login" <%= locals.error_message ? 'open' : '' %>>
                    <summary>Masz już konto? Zaloguj się <span aria-hidden="true">+</span></summary>
                    <form id="login-form" action="/login" method="post">
                        <label for="username">Nazwa gracza</label>
                        <input id="username" type="text" autocomplete="username" required name="username" placeholder="Twoja nazwa" />
                        <label for="password">Hasło</label>
                        <input id="password" type="password" autocomplete="current-password" required name="password" placeholder="Twoje hasło" />
                        <button class="button button-secondary" type="submit">Zaloguj się</button>
                    </form>
                </details>
            </div>
            <div class="expedition-map village-map" aria-label="Polana z ogniskiem, domkami i wodą">
                <div class="map-heading"><span>WASZ KAWAŁEK ŚWIATA</span><span>01 / POLANA</span></div>
                <svg viewBox="0 0 440 440" role="img" aria-label="Schemat polany: domy, ognisko i fale przeciwników">
                    <defs>
                        <pattern id="map-grid" width="32" height="32" patternUnits="userSpaceOnUse"><path d="M32 0H0V32" fill="none" stroke="#a6aa8f" stroke-opacity=".065" /></pattern>
                        <radialGradient id="map-glow"><stop stop-color="#c7a466" stop-opacity=".20" /><stop offset="1" stop-color="#c7a466" stop-opacity="0" /></radialGradient>
                    </defs>
                    <rect width="440" height="440" fill="url(#map-grid)" />
                    <circle cx="225" cy="218" r="190" fill="url(#map-glow)" />
                    <path d="M371 0Q319 87 359 150T337 287T373 440H440V0Z" fill="#426c702e" stroke="#638b8755" />
                    <g fill="none" stroke="#6f7b66" stroke-width="1" opacity=".25"><path d="M35 87Q177 10 294 95M20 110Q177 30 310 118M24 343Q172 433 318 351M32 365Q172 453 327 374" /></g>
                    <path d="M109 154Q216 165 218 230T286 318M218 230L303 162M218 230L122 297" fill="none" stroke="#b7a57c" stroke-width="19" opacity=".12" />
                    <g stroke="#c5a36b" stroke-width="1.5" fill="#27322a">
                        <path d="M79 153V112H130V153ZM71 115L104 83L138 115ZM93 153V134H110V153" />
                        <path d="M267 175V132H318V175ZM259 135L292 104L326 135ZM281 175V155H298V175" />
                        <path d="M88 326V288H134V326ZM80 291L111 261L142 291ZM102 326V307H118V326" />
                    </g>
                    <circle cx="219" cy="230" r="48" fill="none" stroke="#d4ac6755" stroke-dasharray="3 7" />
                    <g stroke="#b28a53" stroke-width="5" stroke-linecap="round"><path d="M205 243L233 234M207 234L232 244" /></g>
                    <path d="M220 201Q222 216 230 222Q241 240 219 241Q200 239 208 225L213 213L215 227Q226 221 220 201Z" fill="#d9a25e" />
                    <path d="M219 221Q232 237 219 238Q209 236 219 221Z" fill="#f5d796" />
                    <g stroke="#758768" fill="#263a28"><path d="M59 209L43 232H75ZM52 221L38 242H80ZM170 95L155 118H185ZM162 108L149 128H191ZM295 284L279 307H311ZM287 297L273 318H316ZM205 326L188 352H221ZM197 342L182 364H228" /></g>
                    <g fill="none" stroke="#9cae8d" stroke-width="1.3" opacity=".75"><path d="M191 55L219 76L247 55M219 40V75M371 218L350 238L371 258M387 238H351M208 389L229 368L250 389M229 405V369" /></g>
                    <g fill="#c4c6af" font-family="Georgia, serif" font-size="12"><text x="219" y="275" text-anchor="middle">Wasze ognisko</text><text x="226" y="27" text-anchor="middle">Nadciągają upiory</text></g>
                </svg>
                <div class="map-footer"><span><i></i> WALCZ · ZBIERAJ · ULEPSZAJ</span><span>6 FAL</span></div>
            </div>
        </main>
        <footer class="landing-footer">
            <span class="controls-label">ZANIM NADCIĄGNĄ</span>
            <span><kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd> ruch</span>
            <span><kbd>LPM</kbd> strzał w kierunku kursora</span>
            <span><kbd>PPM</kbd> fala mocy</span>
            <span><kbd>Enter</kbd> czat drużyny</span>
            <span class="friendly-note">Wspólne PD i łup. Bez obrażeń od sojuszników.</span>
        </footer>
    </div>
</body>
</html>
