{
  "name": "node-mmo-game",
  "description": "Multiplayer browser game built with Node.js, Socket.IO and PixiJS",
  "version": "0.0.1",
  "private": true,
  "author": "Tomasz Piecha",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "check": "tsc --noEmit",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "start": "node dist/app.js"
  },
  "dependencies": {
    "detect-collisions": "2.7.0",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "keypress.js": "^2.1.5",
    "mongoose": "^9.9.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "socket.io-msgpack-parser": "^3.0.2"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/keypress.js": "^2.1.3",
    "@types/node": "^24.0.0",
    "@types/pixi.js": "^4.4.4",
    "typescript": "5.9.3"
  }
}
